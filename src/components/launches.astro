---
import { getLaunches } from '../services/launches.ts';
import { Image } from 'astro:assets';

const launches = await getLaunches();
const first = launches[0];
const rocket = first?.rocket?.configuration?.name ?? first?.rocket?.name ?? 'To be announced';
const agency = first?.launch_service_provider?.name ?? first?.agency?.name ?? 'To be announced';
const location = first?.pad?.location?.name ?? first?.location?.name ?? 'To be announced';
const orbit = first?.mission?.orbit?.name ?? first?.orbit?.name ?? 'To be announced';
---

<div class="launch-feature">
  <div class="launch-card">
    <h1>{rocket ?? 'Upcoming launches'}</h1>
    <span class="section-separator"></span>
    <h2>Launch info, lined up</h2>
    <p class="launch-description">
      Check upcoming launches and dive deeper with detailed mission information and data.*
    </p>

    <div class="rocket-information">
      <h3>Rocket information</h3>
      <ul class="launch-details">
        <li><span>Rocket</span><span>{first?.name}</span></li>
        <li><span>Agency</span><span>{agency}</span></li>
        <li><span>Location</span><span>{location}</span></li>
        <li><span>Orbit</span><span>{orbit}</span></li>
      </ul>
    </div>

    <div class="launch-information-section">
    <a class="launch-more" href="/rocket">More details <span aria-hidden="true">→</span></a>
</div>
  </div>


  <div class="image-container">
<Image class="launch-image" src={first?.image?.image_url ?? '/images/rocket-placeholder-image.jpg'}
  width={1200} height={800} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 55vw"
  format="webp" quality={65} loading="eager" fetchpriority="high"
  alt={first ? `Rocket for ${first.name}` : 'Rocket launch'} />
      {first && <p class="countdown" data-launch-date={first.net}>Loading...</p>}
      <a class="schedule-hyper" href="/schedules">More Launches <span aria-hidden="true">→</span></a>
  </div>
</div>

<style>

.launch-image {
  width: 100%;
  height: min(620px, 65vw);
  min-height: 360px;
  object-fit: cover;
  border-radius: 10px;
  opacity: 0.6;
}

.image-container {
  position: relative;
}

.launch-feature {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: clamp(32px, 6vw, 88px);
  align-items: center;
}

.launch-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}

.section-separator {
  border-bottom: 1px solid var(--border-primary); 
  margin-bottom: 25px;
  width: 600px;
}

.launch-card h1 {
  margin: 0 0 30px;
  font-size: clamp(2rem, 4vw, 3.25rem);
  line-height: 1.1;
}

.launch-card h2 {
  margin: 0 0 10px;
  font-size: clamp(1.35rem, 2.5vw, 1.75rem);
}


.rocket-information {
  width: 100%;
  margin-top: 34px;
}

.rocket-information h3 {
  margin: 0 0 12px;
  font-size: 1rem;
}

.launch-details {
  list-style: none;
  padding: 0;
  margin: 0;
  width: 100%;
}

.launch-details li {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 11px 0;
}

.launch-details li span:first-child {
  color: var(--text-muted-foreground);
}

.launch-details li span:last-child {
  text-align: right;
}

.launch-information-section {
  display: grid;
  justify-content: center;
  width: 100%;
  margin-top: 32px;
}

.launch-more {
  color: var(--foreground-text);
  font-size: var(--text-lg);
  font-weight: 600;
}

.launch-more span,
.schedule-hyper span {
  display: inline-block;
  transition: transform 0.2s ease;
}

.launch-more:hover span,
.schedule-hyper:hover span {
  transform: translateX(4px);
}

.launch-description {
  margin: 0;
  max-width: 42ch;
  color: var(--text-muted-foreground);
  line-height: 1.6;
  padding-bottom: 60px;
}

.schedule-hyper {
  position: absolute;
  bottom: 5%;
  left: 50%;
  transform: translateX(-50%);
  width: max-content;
  color: var(--foreground-text);
  font-size: var(--text-lg);
  font-weight: 600;
  border-radius: 5px;
  padding: 15px;
  background: rgba(255, 255, 255, 0.1);
}

.countdown {
  position: absolute;
  top: -10%;
  font-size: 45px;
  letter-spacing: 1.9px;
  width: 100%;
  text-align: center;
  color: var(--foreground-text) !important;
  padding-top: 50px;
  padding-bottom: 25px;
  border-bottom: 1px solid var(--border-secundary);
  font-weight: bolder;
}

</style>
<script>
console.log(first?.image?.image_url);
</script>
