---
import { getArticles }  from '../services/spaceflight.ts';
import { formatDate } from '../lib/formatDate.ts';

const articles = await getArticles();

---



    <h1>Articles</h1>
<div class="article-grid">
  {articles.map((article) => (
    <article class="article-card">
      <!-- might delete the image url -->
    <img class="article-image" src={article.image_url} alt="" loading="lazy" />

    <div class="article-content">
      <p class="article-date">{formatDate(article.published_at)}</p>
      <h3>{article.title}</h3>

    <div class="article-footer">
      <a href={article.url} target="_blank" rel="noopener noreferrer">View article ↗︎</a>
</div>
    </div>
    </article>
  ))}
</div>
