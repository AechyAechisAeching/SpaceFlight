---
import { Image } from 'astro:assets';
import { getArticles }  from '../services/spaceflight.ts';
import { formatDate } from '../lib/formatDate.ts';

const articles = await getArticles();
---



    <h1>Articles</h1>
<div class="article-grid">
  {articles.map((article) => (
<a class="article-card" href={article.url} target="_blank" rel="noopener noreferrer">
    <Image class="article-image"
src={article.image_url} alt={article.title ?? ""} width={400} height={200}
quality={65} format="webp" loading="lazy" widths={[300, 600, 900]}
sizes="(max-width: 640px) 100vw, (max-width: 960px) 80vw, 60vw" />
    <div class="article-content">
      <p class="article-date"> {article.authors[0]?.name ?? ""} · {formatDate(article.published_at)}</p>
      <h3>{article.title}</h3>
    </div>
    </a>
  ))}
</div>



<style>

.article-grid {
  display: grid;
  column-gap: 35px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.article-card {
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr);
  border-bottom: 1px solid var(--border-primary);
  padding: 20px;
  color: inherit;
  text-decoration: none;
  transition: transform 0.2s ease;
}

.hyper {
  color: var(--text-muted-foreground);
  font-size: var(--card-date);
}

.article-card:hover{
  transform: scale(1.01);
}

.article-image {
  width: 150px;
  height: 100px;
  object-fit: cover;
  border-radius: 8px;
}

.article-content {
  padding-left: 5px;
}

.article-date {
  margin-left: 10px;
  margin-top: 1px;
  margin-bottom: 0px;
  font-size: var(--card-date);
  color: var(--text-muted-foreground);
}

.article-content h3 {
  margin-left: 10px;
  margin-top: 8px;
  font-size: var(--card-header);
  font-weight: 700;
}

.article-content a {
  text-decoration: underline;
  text-decoration-thickness: 1.5px;
  text-decoration-color: rgba(0, 0, 0, 0.3);
  text-underline-offset: 0.2em;
  transition: text-decoration-color 0.2s ease;
}

.article-content a:hover {
  text-decoration-color: currentColor;
}



</style>
