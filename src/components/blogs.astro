---
  import { getBlogs } from '../services/spaceflight.ts';
  import { formatDate} from '../lib/formatDate.ts';

  const blogs = await getBlogs();

---

<h1>Blogs</h1>
<!-- <div class="blog-grid"> -->
  {blogs.map((blog) => (
    <article class="blog-card">
    <div class="blog-content">

    <p>{formatDate(blog.published_at)}</p>
      <h2>{blog.title}</h2>
      <p>{blog.summary}</p>
  </div>
      <img class="blog-image" src={blog.image_url}>
  </article>
  ))}
<!-- </div> -->
