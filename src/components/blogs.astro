---
  import { getBlogs } from '../services/spaceflight.ts';
  import { formatDate} from '../lib/formatDate.ts';

  const blogs = await getBlogs();
---

<h1>Blogs</h1>
{blogs.map((blog) => (
<a class="blog-card" href={blog.url} target="_blank" rel="noopener noreferrer">
    <div class="blog-content">
      <div class="blog-meta">
      <div class="blog-meta-left">
      {blog.author_avatar ? (
        <img class="blog-avatar" src={blog.author_avatar} alt="" />
      ) : (
        <span class="blog-avatar blog-avatar-placeholder" aria-hidden="true"></span>
      )}
      <p class="top-meta">{blog.authors[0]?.name ?? ""} </p>
      </div>

      <div class="blog-meta-right">
      <p class="top-meta">{formatDate(blog.published_at)}</p>
      </div>
      </div>

      <h2>{blog.title}</h2>
      <p class="blog-summary">{blog.summary}</p>
    </div>

<img class="blog-image" src={blog.image_url} onerror="this.onerror=null; this.src='/images/unavailable-rocket.svg';" alt="" loading="lazy" />
  </a>
))}

<style>
.blog-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  gap: 32px;
  align-items: start;
  padding: 20px;
  padding-bottom: 40px;
  border-bottom: 1px solid var(--border-primary);
  color: inherit;
  text-decoration: none;
  transition: transform 0.3s ease;
}

.blog-card:hover{
  transform: scale(1.01);
}

.blog-content {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
}

.blog-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  font-size: 14px;
  color: var(--text-muted-foreground);
}

.top-meta {
  margin-left: 10px;
  margin: 0;
  font-size: var(--card_date);
  color: var(--text-muted-foreground);
}

.blog-meta-left,
.blog-meta-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.blog-author {
  color: var(--text-primary);
}

.blog-avatar {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  object-fit: cover;
}

.blog-avatar-placeholder {
  display: block;
  background: url('/images/nasa-logo.png') center / cover no-repeat;
}

.blog-content h2 {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 700;
  line-height: 1.25;
}

.blog-summary {
  margin: 0;
  color: var(--text-muted-foreground);
  display: -webkit-box;
  padding-right: 80px;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.blog-image {
  width: 300px;
  height: 160px;
  object-fit: cover;
  border-radius: 8px;
}

</style>
