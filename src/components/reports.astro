---
import { getReports } from '../services/spaceflight.ts';
import { formatDate } from '../lib/formatDate.ts';

const reports = await getReports(); 

---

<h1>Reports</h1>
    {reports.map((report) => (
    <article>
    <h2>{report.title}</h2>
      <!-- <img src={report.image_url}> -->
      <p>{report.summary}</p>
      <p>{formatDate(report.published_at)}</p>
    </article>
  
    ))}
