---
import '../styles/global.css'

const { title } = Astro.props

---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/images/planet-logo.svg" />
		<meta name="generator" content={Astro.generator} />
    <title>{title}</title>
	</head>
</html>

<main class="Pager">
      <a class="back-button" aria-label="return to homepage" href="/">← <span aria-hidden="true">Go back</span></a>
  <slot />
</main>


<style>

.Pager {
  max-width: 1500px;
}

.back-button {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--foreground-text);
  font-size: var(--card-header);
  font-weight: 600;
  line-height: 1.4;
}

</style>
