---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getLaunches, getRocketConfiguration } from '../services/launches.ts';
const launches = await getLaunches();
const first = launches[0];
const configurationId = first?.rocket?.configuration?.id;
const rocketConfiguration = configurationId
  ? await getRocketConfiguration(configurationId)
  : undefined;
const currentRocket = first?.rocket?.configuration?.name
  ?? first?.rocket?.name ?? 'To be announced';
const currentAgency = first?.launch_service_provider?.name ?? first?.agency?.name ?? 'To be announced';
const currentVariants = first?.rocket?.configuration?.variant
  ?? rocketConfiguration?.variant
  ?? first?.rocket?.variant?.toString()
  ?? 'No variants available';
const currentLocation = first?.pad?.location?.name ?? first?.location?.name ?? 'To be announced';
const currentOrbit = first?.mission?.orbit?.name ?? first?.orbit?.name ?? 'To be announced';
const launchStatus = first?.status?.name ?? 'To be announced';
const manufacturer = first?.rocket?.configuration?.manufacturer ?? rocketConfiguration?.manufacturer;
const currentManufacturerName = manufacturer?.name
  ?? rocketConfiguration?.manufacturer?.name
  ?? 'To be announced';
const manufacturerDescription = manufacturer?.description || 'No manufacturer description available.';
const manufacturerFounded = manufacturer?.founding_year ?? 'Not available';
const countryCode = manufacturer?.country_code ?? 'Not available';
const manufacturerType = manufacturer?.type ?? 'To be announced';
const manufacturerCountry = typeof countryCode === 'string'
  ? countryCode
  : countryCode && typeof countryCode === 'object'
    ? countryCode.alpha_2 ?? countryCode.code ?? countryCode.name ?? 'To be announced'
    : 'To be announced';
const totalLaunches = rocketConfiguration?.total_launch_count;
const successfulLaunches = rocketConfiguration?.successful_launches;
const successRate = typeof totalLaunches === 'number' && totalLaunches > 0 && typeof successfulLaunches === 'number'
  ? `${Math.round((successfulLaunches / totalLaunches) * 100)}% (${successfulLaunches}/${totalLaunches})`
  : 'To be announced';
const launchDate = first?.net ? new Date(first.net) : undefined;
const formattedLaunchDate = launchDate && !Number.isNaN(launchDate.getTime())
  ? launchDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
  : 'To be announced';
const launchTime = launchDate && !Number.isNaN(launchDate.getTime())
  ? `${launchDate.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' })} UTC`
  : 'To be announced';
const mission = first?.mission;
const pad = first?.pad;
const latitude = pad?.latitude ?? 'To be announced';
const longitude = pad?.longitude ?? 'To be announced';
---

<Layout>
  <main>
    <!-- Rocket information with timer section -->

    <section class="rocket-features">
      <div class="rocket-visual">
        {first?.image?.image_url && <Image src={first.image.image_url} width={1200} height={722} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 55vw"
  format="webp" quality={65} loading="eager" fetchpriority="high" alt={`Launch vehicle for ${first.name}`} />}
        <p class="visual-caption">{currentLocation}</p>
      </div>
      <div class="rocket-card">
        <div class="rocket-heading">
          <h1>{currentRocket}</h1>
          <p class="rocket-status"><span aria-hidden="true">✓</span>{launchStatus}</p>
        </div>
        <ul class="rocket-meta">
          <li><span>Launch provider</span><span>{currentAgency}</span></li>
          <li><span>Variant</span><span>{currentVariants}</span></li>
        </ul>
        <div class="departure-heading">
          <div><h2>Next departure</h2><p>{formattedLaunchDate} · {launchTime}</p></div>
          <span class="departure-orbit" aria-hidden="true">↗</span>
        </div>
        {first?.net ? (
          <div class="featured-countdown" data-countdown data-launch-date={first.net} role="timer" aria-label="Time until launch">
            <div class="countdown-unit"><span data-countdown-days>—</span><small>Days</small></div>
            <div class="countdown-unit"><span data-countdown-hours>—</span><small>Hours</small></div>
            <div class="countdown-unit"><span data-countdown-minutes>—</span><small>Minutes</small></div>
            <div class="countdown-unit countdown-seconds"><span data-countdown-seconds>—</span><small>Seconds</small></div>
          </div>
        ) : <p class="countdown-unavailable">Launch time to be announced</p>}
      </div>
    </section>





<section class="section-information">

  <div class="fields">
  <div class="section-head">
    <h2>Mission Overview</h2>
    <p>What is the flight about</p>
  </div>


    <div class="field">
      <span class="field-label">Mission name</span>
      <span class="field-value">{mission?.name ?? 'To be announced'}</span>
    </div>
    <div class="field">
      <span class="field-label">Mission type</span>
      <span class="field-value">{mission?.type ?? 'To be announced'}</span>
    </div>
    <div class="field">
      <span class="field-label">Mission orbit</span>
      <span class="field-value">{currentOrbit}</span>
    </div>
    <div class="field">
      <span class="field-label">Mission abbrev</span>
      <span class="field-value">{mission?.abbrev ?? 'To be announced'}</span>
    </div>

    <div class="field field-wide">
      <span class="field-label">Description</span>
      <span class="field-value">{mission?.description ?? 'No mission description available.'}</span>
    </div>
  </div>
</section>

    <section class="section-information">
      <div class="fields">
      <div class="section-head">
      <h2>Launch information</h2>
      <p>Information about the rocket</p>
        </div>

      <div class="field">
          <span class="field-label">Launch Date</span>
      <span class="field-value">{formattedLaunchDate}</span>
      </div>
      <div class="field">
      <span class="field-label">Time (UTC)</span>
      <span class="field-value">{launchTime}</span>
      </div>
      <div class="field">
      <span class="field-label">Launchpad</span>
      <span class="field-value">{pad?.name ?? 'To be announced'}</span>
      </div>
        <div class="field">
        <span class="field-label">Country</span>
          <span class="field-value">{countryCode}</span>
        </div>
        <div class="field">
        <span class="field-label">Total pad launches</span>
        <span class="field-value">{pad?.total_launch_count ?? 'To be announced'}</span>
        </div>
        <div class="field">
          <span class="field-label">Latitude</span>
        <span class="field-value">{latitude}</span>
        </div>
        <div class="field">
        <span class="field-label">Longitude</span>
        <span class="field-value">{longitude}</span>

        </div>
      </div>
    </section>

    <section class="section-information">
      <div class="fields">
    <div class="section-head">
    <h2>Manufacturer</h2>
     <p>Manufacturer information</p>
        </div>
        <div class="field">
        <span class="field-label">Manufacturer name</span>
          <span class="field-value">{currentManufacturerName}</span>
        </div>
        <div class="field">
        <span class="field-label">Founded</span>
        <span class="field-value">{manufacturerFounded}</span>
        </div>
        <div class="field">
        <span class="field-label">Rocket configuration</span>
        <span class="field-value">{currentRocket}</span>
        </div>
        <div class="field">
        <span class="field-label">Type</span>
        <span class="field-value">{manufacturerType}</span>
        </div>
        <div class="field">
        <span class="field-label">Success rate</span>
        <span class="field-value">{successRate}</span>
        </div>
        <div class="field">
        <span class="field-label">Country of Origin</span>
        <span class="field-value">{manufacturerCountry}</span>
        </div>
        <div class="field field-wide">
        <span class="field-label">Manufacturer description</span>
          <span class="field-value">{manufacturerDescription}</span>
        </div>

      </div>


    </section>

  </main>
</Layout>

<style>

.rocket-features {
  display: grid;
  grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr);
  min-height: 34rem;
  margin: 0 0 7rem;
}

.rocket-visual {
  position: relative; 
  min-height: 34rem; 
  overflow: hidden; 
  background: #17191d;
}

.rocket-visual::after {
  content: ''; 
  position: absolute; 
  inset: 40% 0 0;
  background: linear-gradient(transparent, rgb(0 0 0 / .72));
  pointer-events: none;
}
.rocket-visual img {
  width: 100%; 
  height: 100%; 
  position: absolute; 
  inset: 0;
  border-radius: 10px;
  object-fit: cover;
}

.visual-caption { 
  position: absolute; 
  z-index: 1;
  left: clamp(1.25rem, 3vw, 2.75rem); 
  bottom: 1.5rem; 
  margin: 0; 
  color: var(--foreground-text);
  font-size: .95rem; 
}

.rocket-card {
  min-width: 0; 
  padding: clamp(1.5rem, 4vw, 4rem); 
  align-self: center; 
}

.rocket-heading { 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
  gap: 1rem; 
  padding-bottom: 1.5rem; 
}

.rocket-heading h1 { 
  margin: 0; 
  font-size: clamp(2rem, 4vw, 3.25rem); 
  line-height: 1.05; 
}

.rocket-status { 
  display: flex; 
  align-items: center; 
  gap: .5rem; 
  flex: none; 
  margin: 0; 
  color: #c5c8cc; 
}

.rocket-status span { 
  color: #8de085; 
}

.rocket-meta { 
  list-style: none;
  padding: 20px 0 30px;
  margin: 0;
  width: 100%;
  border-top: 1px solid var(--border-primary); 
}

.rocket-meta li {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 11px 0;
}

.rocket-meta li span:last-child {
  color: var(--text-muted-foreground);
}

.rocket-meta li span:last-child {
  text-align: right;
}

.departure-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rem;
}

.departure-heading h2 { 
  margin: 0 0 .35rem;
  font-size: 1.45rem;
  letter-spacing: -.025em;
}

.departure-heading p { 
  margin: 0;
  color: #aeb1b6;
}

.departure-orbit { 
  display: grid; 
  place-items: center; 
  width: 2.6rem;
  height: 2.6rem; 
  font-size: 1.3rem;
}

.featured-countdown {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: .7rem; 
}

.countdown-unit { 
  display: flex;
  min-width: 0;
  min-height: 8.5rem; 
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 0.5px solid var(--border-primary);
  border-radius: 4px;
  font-variant-numeric: tabular-nums;
}

.countdown-unit span {
  font-size: clamp(2.7rem, 5vw, 5rem);
  font-weight: 650; line-height: .98;
  letter-spacing: -.06em; 
}

.countdown-unit small {
  margin-top: .65rem;
  color: #aeb1b6;
  font-size: .82rem;
  text-transform: uppercase;
}

.countdown-unavailable {
  margin: 0;
  color: #d3d5d8; 
}

.launch-image {
  display: block;
  width: min(100%, 60rem);
  max-height: 32rem;
  margin: 2rem auto;
  object-fit: cover;
  border-radius: 0.75rem;
}

.section-information {
  padding: 2rem 1rem;
  border-top: 1px solid var(--border-primary);
}

.section-head {
  display: flex;
  flex-direction: column;

}
.section-head p {
  color: var(--text-muted-foreground);
  padding: 0;
  margin: 0;
}

.section-head h2{
  margin: 0 0 1rem;
  font-size: 2rem;
  width: max-content;
  font-weight: 600;
}

.fields {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 2.5rem 3rem;
}

.fields .field:nth-child(6) {
  grid-column-start: 2;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding-bottom: 1.7rem;
  padding-top: .75rem;
  border-bottom: 1px solid var(--border-primary);
}

.field-label {
  color: var(--text-muted-foreground);
  font-size: 1.1rem;
}

.field-value {
  font-size: 1.1rem;
}

.field-wide {
  grid-column: 2 / -1; 
  padding-bottom: 2rem;
}

@media (max-width: 1000px) {
  .rocket-features { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); }
  .rocket-visual { min-height: 30rem; }
  .rocket-card { padding: 2rem; }
  .rocket-heading { align-items: flex-start; flex-direction: column; }
  .fields { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .fields .field:nth-child(6) { grid-column-start: auto; }
  .field-wide { grid-column: span 2; }
}
@media (max-width: 640px) {
  .rocket-features { grid-template-columns: 1fr; margin-bottom: 4rem; }
  .rocket-visual { min-height: 20rem; }
  .rocket-card { padding: 1.5rem 1rem; }
  .rocket-heading { padding-bottom: 1rem; flex-direction: row; align-items: center; }
  .rocket-heading h1 { font-size: clamp(2rem, 9vw, 3rem); }
  .rocket-status { font-size: .85rem; }
  .featured-countdown { gap: .4rem; }
  .countdown-unit { min-height: 6.5rem; }
  .countdown-unit span { font-size: clamp(2rem, 11vw, 3.5rem); }
  .countdown-unit small { font-size: .65rem; }
  .section-information { padding: 1.5rem 0; }
  .fields { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .section-head, .field-wide { grid-column: 1 / -1; }
  .section-head h2 { width: auto; font-size: 1.5rem; }
  .field-label, .field-value { font-size: 1rem; overflow-wrap: anywhere; }
  .launch-image { max-height: 24rem; margin: 1.5rem auto; }
}
@media (max-width: 380px) {
  .fields { grid-template-columns: minmax(0, 1fr); }
  .section-head, .field-wide { grid-column: auto; }
}

</style>
<script>
  import '../lib/countdown.ts';
</script>
