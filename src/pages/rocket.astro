---
import Layout from '../layouts/Layout.astro';
import { getLaunches, getRocketConfiguration } from '../services/launches.ts';
const launches = await getLaunches();
const first = launches[0];
const configurationId = first?.rocket?.configuration?.id;
const rocketConfiguration = configurationId
  ? await getRocketConfiguration(configurationId)
  : undefined;
const currentRocket = first?.rocket?.configuration?.name
  ?? first?.rocket?.name ?? 'To be announced';
const currentAgency = first?.launch_service_provider?.name ?? first?.agency?.name ?? 'To be announced';
const currentVariants = first?.rocket?.configuration?.variant ?? 'No variants available';
const currentLocation = first?.pad?.location?.name ?? first?.location?.name ?? 'To be announced';
const currentOrbit = first?.mission?.orbit?.name ?? first?.orbit?.name ?? 'To be announced';
const launchStatus = first?.status?.name ?? 'To be announced';
const currentManufacturer = first?.rocket?.configuration?.manufacturer?.name
  ?? rocketConfiguration?.manufacturer?.name
  ?? 'To be announced';
---

<Layout>
  <main>
    <h1>{currentRocket}</h1>
    <h2>Launch status</h2>
    <p>{launchStatus}</p>
    <h2>Agency</h2>
    <p>{currentAgency}</p>
    <h2>Location</h2>
    <p>{currentLocation}</p>
    <h2>Orbit</h2>
    <p>{currentOrbit}</p>
    <h2>Variants</h2>
    <p>{currentVariants}</p>
    <h1>Departure</h1>
    {first?.net && <p class="countdown" data-launch-date={first.net}>Loading countdown…</p>}

  <!-- <img -->
  <!--   src={first?.image?.image_url ?? '/images/rocket-placeholder-image.jpg'} -->
  <!--   alt={first ? `Rocket for ${first.name}` : 'Rocket launch'} -->
  <!--   class="launch-image" -->
  <!-- /> -->
  <!---->

<section class="section-information">

  <div class="fields">
  <div class="section-head">
    <h2>Mission Overview</h2>
    <p>What is the flight about</p>
  </div>


    <div class="field">
      <span class="field-label">Mission name</span>
      <span class="field-value">Info</span>
    </div>
    <div class="field">
      <span class="field-label">Mission type</span>
          <span class="field-value">Info</span>
    </div>
    <div class="field">
      <span class="field-label">Mission orbit</span>
      <span class="field-value">Info</span>
    </div>
    <div class="field">
      <span class="field-label">Mission abbrev</span>
      <span class="field-value">Info</span>
    </div>

    <div class="field field-wide">
      <span class="field-label">Description</span>
      <span class="field-value">Some lovely information about this lovely little shuttle</span>
    </div>
  </div>
</section>

    <section class="section-information">
      <div class="fields">
      <div class="section-head">
      <h2>Launch information</h2>
      <p>Information about the rocket</p>
        </div>

      <div class="field">
          <span class="field-label">Launch Date</span>
      <span class="field-value">Info</span>
      </div>
      <div class="field">
      <span class="field-label">Time (UTC)</span>
      <span class="field-value">Info</span>
      </div>
      <div class="field">
      <span class="field-label">Launchpad</span>
      <span class="field-value">Info</span>
      </div>
        <div class="field">
        <span class="field-label">Country</span>
        <span class="field-value">Info</span>
        </div>
        <div class="field">
        <span class="field-label">Total pad Launches</span>
        <span class="field-value">Info</span>
        </div>
        <div class="field">
          <span class="field-label">Latitude</span>
        <span class="field-value">Info</span>
        </div>
        <div class="field">
        <span class="field-label">Longtitude</span>
        <span class="field-value">Info</span>

        </div>
      </div>
    </section>

    <section class="section-information">
      <div class="fields">
    <div class="section-head">
    <h2>Manufacturer</h2>
     <p>Manufacturer information</p>
        </div>
        <div class="field">
        <span class="field-label">Manufacturer name</span>
          <span class="field-value">{currentManufacturer}</span>
        </div>
        <div class="field">
        <span class="field-label">About the manufactorer</span>
        <span class="field-value">Info</span>
        </div>
        <div class="field">
        <span class="field-label">Founded</span>
        <span class="field-value">Info</span>
        </div>
        <div class="field">
        <span class="field-label">Rocket configurations</span>
        <span class="field-value">Info</span>
        </div>
        <div class="field">
        <span class="field-label">Spacecraft & missions</span>
        <span class="field-value">Info</span>
        </div>
        <div class="field">
        <span class="field-label">Success rate</span>
        <span class="field-value">Info</span>
        </div>
        <div class="field">
        <span class="field-label">Country of Origin</span>
        <span class="field-value">Info</span>
        </div>
        <div class="field field-wide">
        <span class="field-label">Manufactorer description</span>
          <span class="field-value">Description regarding the Manufactorer</span>
        </div>

      </div>


    </section>

  </main>
</Layout>

<style>

.section-information {
  padding: 2rem 1rem;
  border-top: 1px solid var(--border-primary);
}

.section-head {
  display: flex;
  flex-direction: column;

}
.section-head p {
  color: var(--text-muted-foreground);
  padding: 0;
  margin: 0;
}

.section-head h2{
  margin: 0 0 1rem;
  font-size: 2rem;
  width: max-content;
  font-weight: 600;
}

.fields {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 2.5rem 3rem;
  /* border-bottom: 1px solid var(--border-primary) */
}

.fields .field:nth-child(6) {
  grid-column-start: 2;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding-bottom: 2rem;
  padding-top: .75rem;
  border-bottom: 1px solid var(--border-primary);
}

.field-label {
  color: var(--text-muted-foreground);
  font-size: 1.1rem;
}

.field-value {
  font-size: 1.1rem;
}

.field-wide {
  grid-column: 2 / -1; 
  padding-bottom: 2rem;
}

</style>
<script>
  import '../lib/countdown.ts';
</script>
