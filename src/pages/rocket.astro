---
import Layout from '../layouts/Layout.astro';
import { getLaunches } from '../services/launches.ts';

const launches = await getLaunches();
const first = launches[0];
const currentRocket = first?.rocket?.configuration?.name
  ?? first?.rocket?.name ?? 'To be announced';
const currentAgency = first?.launch_service_provider?.name ?? first?.agency?.name ?? 'To be announced';
const currentVariants = first?.rocket?.configuration?.variant ?? 'No variants available';
const currentLocation = first?.pad?.location?.name ?? first?.location?.name ?? 'To be announced';
const currentOrbit = first?.mission?.orbit?.name ?? first?.orbit?.name ?? 'To be announced';
const launchStatus = first?.status?.name ?? 'To be announced';

---

<Layout>
  <main>
    <h1>{currentRocket}</h1>
    <h2>Launch status</h2>
    <p>{launchStatus}</p>
    <h2>Agency</h2>
    <p>{currentAgency}</p>
    <h2>Location</h2>
    <p>{currentLocation}</p>
    <h2>Orbit</h2>
    <p>{currentOrbit}</p>
    <h2>Variants</h2>
    <p>{currentVariants}</p>
    <h1>Departure</h1>
    {first?.net && <p class="countdown" data-launch-date={first.net}>Loading countdown…</p>}

  <img
    src={first?.image?.image_url ?? '/images/rocket-placeholder-image.jpg'}
    alt={first ? `Rocket for ${first.name}` : 'Rocket launch'}
    class="launch-image"
  />

<section class="section-information">
  <div class="section-head">
    <h2>Mission Overview</h2>
    <p>What is the flight about</p>
  </div>

  <div class="fields">
    <div class="field">
      <span class="field-label">Head</span>
      <span class="field-value">Info</span>
    </div>
    <div class="field">
      <span class="field-label">Head</span>
          <span class="field-value">Info</span>
    </div>
    <div class="field">
      <span class="field-label">Head</span>
      <span class="field-value">Info</span>
    </div>
    <div class="field">
      <span class="field-label">Head</span>
      <span class="field-value">Info</span>
    </div>

    <div class="field field-wide">
      <span class="field-label">Description</span>
      <span class="field-value">Some lovely information about this lovely little shuttle</span>
    </div>
  </div>
</section>


  </main>
</Layout>

<style>
.information-section {
  display: grid;
  grid-template-columns: minmax(220px, 1fr), 3fr;
  gap: 2rem;
  padding: 2rem 3rem;
  border-top: 1px solid var(--primary-border);
}

.section-head h2{
  margin: 0 0 1rem;
  font-size: 2rem;
  font-weight: 600;
}

.fields {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2.5rem 3rem;
}

.field {
display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--line);
}

.field-label {
  color: var(--text-muted-foreground);
  font-size: 1.1rem;
}

.field-value {
  font-size: 1.1rem;
}

.field-wide {
  grid-column: 1 / -1; 
  border-bottom: 1px solid var(--primary-border);
}

</style>
<script>
  import '../lib/countdown.ts';
</script>
