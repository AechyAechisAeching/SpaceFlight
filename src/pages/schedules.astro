---
import PageLayout from '../layouts/PageLayout.astro';
import { getAllLaunches } from '../services/launches.ts';
import { formatDate } from '../lib/formatDate.ts';
import { getLaunchSlug } from '../lib/launchSlug.ts';
const launches = await getAllLaunches();
const formatLaunchDate = (dateString: string) => {
  const date = new Date(dateString);
  if (Number.isNaN(date.getTime())) return 'Date to be announced';

  const day = String(date.getDate()).padStart(2, '0');
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const year = date.getFullYear();
  return `${day}-${month}-${year}`;
};
---

<PageLayout title="Scheduled launches">
  <main>
    <h1>Upcoming Launches</h1>
    <p class="title-description">Every rocket on the pad next, with live countdowns. Pick a launch to dive into the rocket, the pad and the mission.</p>

    <div class="schedule-controls">
      <label for="schedule-order">Sort launches</label>
      <select id="schedule-order" aria-label="Sort launches by date">
        <option value="newest" selected>Oldest to latest</option>
        <option value="oldest">Latest to oldest</option>
      </select>
    </div>

    <section class="cards-section">
    {launches.map((launch) => (
      <a class="column-card" data-launch-date={launch.net ?? ''} href={`/rocket/${getLaunchSlug(launch)}`}>
        <img class="column-image" src={launch.image?.image_url ?? '/images/rocket-placeholder-image.jpg'} alt={`Rocket for ${launch.name}`} loading="lazy" />
        <div class="card-content">
          <p class="card-info">{launch.launch_service_provider?.name} · {formatLaunchDate(launch.net)}</p>
          <h2>{launch.name}</h2>
          <p class="description-control">{launch.mission?.name} · {launch.pad?.location?.name}</p>
          <div class="card-countdown">
            {launch.net && <span class="countdown" data-launch-date={launch.net}>Loading...</span>}
          </div>
        </div>
      </a>
    ))}

    </section>
  </main>
</PageLayout>
<script>
import '../lib/countdown.ts';

const orderselect = document.querySelector<HTMLSelectElement>('#schedule-order');
const launchlist = document.querySelector<HTMLElement>('.cards-section');

orderselect?.addEventListener('change', () => {
  if (!launchlist) return;

  const newestFirst = orderselect.value === 'newest';
  const cards = Array.from(launchlist.querySelectorAll<HTMLElement>('.column-card'));
  cards.sort((a, b) => {
    const dateA = Date.parse(a.dataset.launchDate ?? '');
    const dateB = Date.parse(b.dataset.launchDate ?? '')
    const validA = Number.isNaN(dateA) ? null : dateA;
    const validB = Number.isNaN(dateB) ? null : dateB;

    if (validA === null) return validB === null ? 0 : 1;
    if (validB === null) return -1;
    return newestFirst ? validB - validA : validA - validB;
  });
  cards.forEach((card) => launchlist.append(card));
});
</script>
<style>

.schedule-controls {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.75rem;
  margin: 1.5rem 0 0.75rem;
}

.schedule-controls label {
  color: var(--text-muted-foreground);
}

.schedule-controls select {
  padding: 0.55rem 1.2rem 0.55rem 0.75rem;
  border: 1px solid var(--border-primary);
  border-radius: 6px;
  background: var(--background-primary);
  color: inherit;
  font: inherit;
}

.column-card {
  display: grid;
  grid-template-columns: 150px 1fr;
  gap: 20px;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid var(--border-primary);
  color: inherit;
  text-decoration: none;
  transition: transform 0.3s ease;
}

.column-card:hover {
  transform: scale(1.01);
}

.column-image {
  width: 150px;
  height: 100px;
  object-fit: cover;
  border-radius: 8px;
}

.card-content {
  display: flex;
  flex-direction: column;
  min-height: 100px;
}

.card-content h3 {
  margin: 0;
}

.card-content h2 {
  margin: 0;
  padding: 0;
}

.card-info {
  margin: 0;
  font-size: var(--card-date);
  color: var(--text-muted-foreground);
  letter-spacing: 0.5px;
  margin-bottom: 9px
}

.card-countdown {
  display: flex;
  justify-content: flex-start;
  margin-top: auto;
  letter-spacing: 1.6px;
}

.description-control {
  margin-top: 10px;
  font-size: var(--text-md);
  color: var(--text-muted-foreground);
}

@media (max-width: 560px) {
  .schedule-controls { justify-content: flex-start; flex-wrap: wrap; }
  .column-card { grid-template-columns: minmax(0, 1fr); gap: .75rem; padding: 1rem 0; }
  .column-image { width: 100%; height: clamp(180px, 55vw, 280px); }
  .card-content { min-height: 0; }
  .card-countdown { margin-top: 1rem; flex-wrap: wrap; letter-spacing: .04em; }
}

</style>
