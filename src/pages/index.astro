---
import Layout from '../layouts/Layout.astro';
import { getArticles }  from '../lib/spaceflight.ts';
import { getBlogs } from '../lib/spaceflight.ts';
import { getReports } from '../lib/spaceflight.ts';
import { getLaunches } from '../lib/launches.ts';

const articles = await getArticles();
const blogs = await getBlogs();
const reports = await getReports();
const launches = await getLaunches();

const launchCountdowns = launches.map((launch) => {
  const launchDate = new Date(launch.net);
  const now = new Date();
  
  const distance = launchDate.getTime() - now.getTime();

  const days = Math.floor(distance / (1000 * 60 * 60 * 24));
  const hours = Math.floor(distance / (1000 * 60 * 60)
  );
  const seconds = Math.floor((distance % (1000 * 60)) / 1000);
  let countdown;

if (days > 0) {
  countdown = `in ${days} days`;
} else if (hours > 0) {
  countdown = `in ${hours} hours`;
} else if (seconds > 0) {
  countdown = `launching in ${seconds} seconds`;
} else {
  countdown = "Shuttle is launching.";
}

return {
  ...launch,
  countdown,
};
 });
---

{launchCountdowns.map((launch) => (
  <article>
    <h2>{launch.name}</h2>
    <p>{launch.countdown}</p>
  </article>
))}

<Layout>


  <section class="article-section">
  {articles.map((article) => (
    <article class="article-card">
      <h2>{article.title}</h2>
      <p>{article.summary}</p>
      <!-- might delete the image url -->
      <!-- <img src={article.image_url}> -->
      <p style="color: blue;">{new Date(article.published_at).toLocaleDateString()}</p>
      <a href={article.url}>Read article</a>
    </article>
  ))}
</section>

  <section>
  {blogs.map((blog) => (
    <article>
    <h2>{blog.title}</h2>
      <!-- <img src={blog.image_url}> -->
      <p style="color: red;">{new Date(blog.published_at).toLocaleDateString()}</p>
    </article>
  ))}
  </section>


  <section>
    {reports.map((report) => (
    <article>
    <h2>{report.title}</h2>
      <!-- <img src={report.image_url}> -->
      <p>{report.summary}</p>
    <p>{new Date(report.published_at).toLocaleDateString()}</p>
    </article>
  
    ))}

  </section>

</Layout>
