---
import Layout from '../layouts/Layout.astro';
import { getArticles }  from '../lib/spaceflight.ts';
import { getBlogs } from '../lib/spaceflight.ts';

const articles = await getArticles();
const blogs = await getBlogs();
---

<Layout>
  <section>
  {articles.map((article) => (
    <article>
      <h2>{article.title}</h2>
      <p>{article.summary}</p>
      <!-- might delete the image url -->
      <img src={article.image_url}>
      <p style="color: blue;">{new Date(article.published_at).toLocaleDateString()}</p>
      <a href={article.url}>Read article</a>
    </article>
  ))}
</section>

  <section>
  {blogs.map((blog) => (
    <article>
    <h2>{blog.title}</h2>
      <img src={blog.image_url}>
      <p style="color: red;">{new Date(blog.published_at).toLocaleDateString()}</p>
    </article>
  ))}

  </section>

</Layout>
