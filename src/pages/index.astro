---
import Layout from '../layouts/Layout.astro';
import { getArticles }  from '../lib/spaceflight.ts';
import { getBlogs } from '../lib/spaceflight.ts';
import { getReports } from '../lib/spaceflight.ts';
import { getLaunches } from '../lib/launches.ts';

const articles = await getArticles();
const blogs = await getBlogs();
const reports = await getReports();
const launches = await getLaunches();

---

<!-- Using this later on probably..-->

<!-- {launchCountdowns.map((launch) => ( -->
<!--   <article> -->
<!--     <h2>{launch.name}</h2> -->
<!--     <p class={launch.status === "launched" ? "launched" : ""}>{launch.countdown}</p> -->
<!--   </article> -->
<!-- ))} -->

<Layout>
  <main>
 <section class="launch-section">
    {launches.map((launch) => (
      <article class="launch-card">
        <h2>{launch.name}</h2>

  <!-- Lower quality but way faster -->
        <!-- src={launch.image.thumbnail_url} -->
        <img
  src={launch.image?.thumbnail_url ?? "/images/rocket-placeholder-image.jpg"}
  alt={launch.name}
  class="launch-image"
/>

        <p  class="countdown" data-launch-date={launch.net}>
          Loading...
        </p>
      </article>
    ))}
  </section>



    <section class="article-section">
  {articles.map((article) => (
    <article class="article-card">
      <h2>{article.title}</h2>
      <p>{article.summary}</p>
      <!-- might delete the image url -->
      <!-- <img src={article.image_url}> -->
      <p style="color: blue;">{new Date(article.published_at).toLocaleDateString()}</p>
      <a href={article.url}>Read article</a>
    </article>
  ))}
</section>

  <section>
  {blogs.map((blog) => (
    <article>
    <h2>{blog.title}</h2>
      <!-- <img src={blog.image_url}> -->
      <p style="color: red;">{new Date(blog.published_at).toLocaleDateString()}</p>
    </article>
  ))}
  </section>


  <section>
    {reports.map((report) => (
    <article>
    <h2>{report.title}</h2>
      <!-- <img src={report.image_url}> -->
      <p>{report.summary}</p>
    <p>{new Date(report.published_at).toLocaleDateString()}</p>
    </article>
  
    ))}

  </section>
  </main>
  </Layout>

  <script>
  const countdowns = document.querySelectorAll(".countdown");

  countdowns.forEach((element) => {
  const launchDate = new Date(
    element.dataset.launchDate!
  ).getTime();

  const updateCountdown = () => {
  const now = new Date().getTime();
  const distance = launchDate - now;


  if (distance <= 0) {
  element.closest(".launch-card")?.remove();
  return;
  }

  const days = Math.floor(
    distance / (1000 * 60 * 60 * 24)
  );

  const hours = Math.floor(
    (distance % (1000 * 60 * 60 * 24)) /
    (1000 * 60 * 60)
  );

  const minutes = Math.floor(
    (distance % (1000 * 60 * 60)) /
    (1000 * 60)
  );

  const seconds = Math.floor(
    (distance % (1000 * 60)) /
    1000
  );
  element.textContent =
  `${days}d ${hours}h ${minutes}m ${seconds}s`;

};

updateCountdown();
    // Currently turned off due repeated fetching requests by image in console (its mad annoying)
//     setInterval(updateCountdown, 1000);
});
document.querySelectorAll<HTMLImageElement>(".launch-image").forEach((image) => {
  image.onerror = () => {
    image.src = "/images/rocket-placeholder-image.jpg";
  };
});
 </script>
